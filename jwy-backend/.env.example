APP_NAME="Jappandal Werg Yaram"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Dakar
APP_LOCALE=fr

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Base de données PostgreSQL ───────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=jwy_db
DB_USERNAME=assbaye
DB_PASSWORD=

# ─── Cache & Sessions ─────────────────────────────────────────────────────────
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# ─── Queue ────────────────────────────────────────────────────────────────────
QUEUE_CONNECTION=redis

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── Mail ─────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@jwy.sn"
MAIL_FROM_NAME="${APP_NAME}"

# ─── JWT Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET=
JWT_TTL=1440
JWT_REFRESH_TTL=20160
JWT_ALGO=HS256

# ─── WebSockets (Pusher protocole) ────────────────────────────────────────────
BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=jwy-app
PUSHER_APP_KEY=jwy-key
PUSHER_APP_SECRET=jwy-secret
PUSHER_HOST=127.0.0.1
PUSHER_PORT=6001
PUSHER_SCHEME=http
PUSHER_APP_CLUSTER=mt1

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_KEY=pk_test_
STRIPE_SECRET=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_

# ─── Orange Money Sénégal ─────────────────────────────────────────────────────
ORANGE_MONEY_URL=https://api.orange.com/orange-money-webpay/sn/v1
ORANGE_MONEY_MERCHANT_KEY=
ORANGE_MONEY_AUTH_TOKEN=
ORANGE_MONEY_NOTIF_URL=https://your-domain.com/api/payment/orange/callback

# ─── Wave Sénégal ─────────────────────────────────────────────────────────────
WAVE_API_URL=https://api.wave.com/v1
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=

# ─── Agora.io (Téléconsultation vidéo) ────────────────────────────────────────
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_TOKEN_EXPIRY=3600

# ─── Stockage (S3 ou local) ───────────────────────────────────────────────────
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-3
AWS_BUCKET=jwy-files
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─── Claude (Anthropic) : assistant IA de pré-orientation ────────────────────
# Clé à créer sur https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
