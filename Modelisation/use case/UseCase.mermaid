graph TB
    %% Acteurs
    Patient[👤 Patient]
    Medecin[👨‍⚕️ Médecin]
    Pharmacien[👨‍💼 Pharmacien]
    Pharmacie[🏥 Pharmacie]
    Administrateur[👨‍💻 Administrateur]
    SystemePaiement[💳 Système de Paiement]
    ServicesUrgence[🚨 Services d'Urgence]

    %% Cas d'utilisation - Gestion des comptes
    subgraph "Gestion des Comptes"
        UC01[S'inscrire]
        UC02[Se connecter]
        UC03[Modifier profil]
        UC04[Gérer les paramètres]
    end

    %% Cas d'utilisation - Dossier Médical
    subgraph "Gestion Dossier Médical"
        UC05[Consulter dossier médical]
        UC06[Mettre à jour dossier médical]
        UC07[Partager dossier médical]
        UC08[Ajouter prescription au dossier]
        UC09[Ajouter résultats de tests]
        UC10[Consulter historique médical]
    end

    %% Cas d'utilisation - Téléconsultation
    subgraph "Téléconsultation"
        UC11[Demander téléconsultation]
        UC12[Effectuer consultation vidéo]
        UC13[Effectuer consultation chat]
        UC14[Envoyer consultation pré-enregistrée]
        UC15[Fournir diagnostic à distance]
        UC16[Système de triage automatique]
    end

    %% Cas d'utilisation - Rendez-vous et Suivi
    subgraph "Rendez-vous et Suivi"
        UC17[Prendre rendez-vous]
        UC18[Planifier rendez-vous]
        UC19[Confirmer rendez-vous]
        UC20[Reporter rendez-vous]
        UC21[Annuler rendez-vous]
        UC22[Suivre traitement]
        UC23[Recevoir rappels de traitement]
    end

    %% Cas d'utilisation - Gestion des Médicaments
    subgraph "Gestion des Médicaments"
        UC24[Prescrire médicament]
        UC25[Vérifier disponibilité médicament]
        UC26[Réserver médicament]
        UC27[Gérer stock pharmacie]
        UC28[Mettre à jour stock temps réel]
        UC29[Localiser pharmacie]
        UC30[Demander livraison à domicile]
    end

    %% Cas d'utilisation - Paiements
    subgraph "Paiements"
        UC31[Payer consultation]
        UC32[Payer médicament]
        UC33[Payer ordonnance]
        UC34[Consulter historique paiements]
        UC35[Traiter paiement]
        UC36[Confirmer transaction]
    end

    %% Cas d'utilisation - Notifications et Alertes
    subgraph "Notifications et Alertes"
        UC37[Envoyer notification]
        UC38[Recevoir alerte santé publique]
        UC39[Diffuser campagne prévention]
        UC40[Alerter épidémie locale]
        UC41[Envoyer rappel médicament]
    end

    %% Cas d'utilisation - Urgences
    subgraph "Gestion des Urgences"
        UC42[Déclencher alerte urgence]
        UC43[Géolocaliser pour urgence]
        UC44[Contacter services urgence]
        UC45[Appliquer protocole critique]
    end

    %% Cas d'utilisation - Formation et Éducation
    subgraph "Formation et Éducation"
        UC46[Consulter contenus éducatifs]
        UC47[Suivre formation professionnelle]
        UC48[Accéder aux tutoriels]
        UC49[Gérer contenus formation]
    end

    %% Cas d'utilisation - Administration
    subgraph "Administration"
        UC50[Gérer utilisateurs]
        UC51[Configurer système]
        UC52[Générer rapports]
        UC53[Monitorer performances]
        UC54[Gérer partenariats]
    end

